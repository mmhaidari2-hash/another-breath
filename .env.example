# Local
DATABASE_URL="file:./dev.db"
AUDIT_SALT="change-me-in-production"

# Production example:
# DATABASE_URL="postgresql://user:pass@host:5432/cladak"
# AUDIT_SALT="long-random-secret"
DEAL_COMPLETE_SECRET="change-me-for-production-webhooks"
COFOUNDER_ACCESS_CODE="change-me"
SESSION_SECRET="long-random-secret"

# App URL (Checkout success/cancel redirects)
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3005"

# Stripe (live GBP success fees)
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# Without Stripe keys, demo checkout at /api/deals/checkout/demo still runs the purge loop.

# Transactional email (Resend). Without key, EmailOutbox still records + marks SENT locally.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Cladak <ops@yourdomain.com>"
