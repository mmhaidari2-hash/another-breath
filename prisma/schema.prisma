// کلادک — Phase 1+ schema (SQLite) with audit + agreements

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  role      String    @default("BUYER")
  createdAt DateTime  @default(now())
  listings  Listing[]
}

model Listing {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String
  category    String  @default("Micro-SaaS")
  websiteUrl  String?
  // PUBLIC = show URL · INTRO_ONLY = hide until platform intro (anti-circumvention)
  demoPolicy  String  @default("INTRO_ONLY")
  tagline     String?
  niche       String?
  techStack   String?
  foundedYear Int?
  featured    Boolean @default(false)

  mrr         Float?
  askingPrice Float
  multiple    Float?

  mrrHistory      String?
  highlights      String?
  reasonForSale   String?
  customersApprox Int?
  businessModel   String?
  gallery         String?

  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id])

  verificationStatus String  @default("PENDING")
  verificationNotes  String?
  verifiedAt         DateTime?

  score Float?
  grade String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads Lead[]

  @@index([verificationStatus, category])
  @@index([featured])
}

model ScoringRubric {
  id         String   @id @default(cuid())
  category   String   @unique
  version    Int      @default(1)
  criteria   String
  gradeBands String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Lead {
  id         String  @id @default(cuid())
  listingId  String
  listing    Listing @relation(fields: [listingId], references: [id])

  buyerName  String
  buyerEmail String
  budget     Float?
  timeline   String?
  message    String?

  acceptedTerms            Boolean @default(false)
  acceptedNonCircumvention Boolean @default(false)
  ipHash                   String?
  userAgent                String?

  createdAt DateTime @default(now())

  @@index([listingId])
  @@index([buyerEmail])
}

model SellerInquiry {
  id                   String   @id @default(cuid())
  name                 String
  email                String
  product              String
  mrr                  String?
  url                  String?
  niche                String?
  askingPrice          String?
  notes                String?
  acceptedSellerTerms  Boolean  @default(false)
  acceptedNonCircumvention Boolean @default(false)
  ipHash               String?
  createdAt            DateTime @default(now())
}

// ممیزی: هر رویداد حساس (بدون ذخیره IP خام)
model AuditEvent {
  id         String   @id @default(cuid())
  action     String
  entityType String?
  entityId   String?
  meta       String?
  ipHash     String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([entityType, entityId])
}

model PlatformConfig {
  id                    String @id @default("default")
  successFeeMinPercent  Float  @default(3)
  successFeeMaxPercent  Float  @default(5)
  supportEmail          String @default("support@cladak.local")
  governingLaw          String @default("To be set by platform owner")
  nonCircumventionDays  Int    @default(730)
}
