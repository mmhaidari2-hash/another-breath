// کلادک — Phase 1+ schema (SQLite)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  role      String    @default("BUYER")
  createdAt DateTime  @default(now())
  listings  Listing[]
}

model Listing {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String
  category    String  @default("Micro-SaaS")
  websiteUrl  String?
  tagline     String?
  niche       String?
  techStack   String?
  foundedYear Int?
  featured    Boolean @default(false)

  mrr         Float?
  askingPrice Float
  multiple    Float?

  // Rich verified payload (JSON strings for SQLite)
  // mrrHistory: [{month,mrr}]
  mrrHistory     String?
  // highlights: string[]
  highlights     String?
  reasonForSale  String?
  customersApprox Int?
  businessModel  String?
  // gallery: [{label,tone}] abstract product frames — not stock photos
  gallery        String?

  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id])

  verificationStatus String  @default("PENDING")
  verificationNotes  String?
  verifiedAt         DateTime?

  score Float?
  grade String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads Lead[]

  @@index([verificationStatus, category])
  @@index([featured])
}

model ScoringRubric {
  id         String   @id @default(cuid())
  category   String   @unique
  version    Int      @default(1)
  criteria   String
  gradeBands String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Lead {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id])
  buyerName  String
  buyerEmail String
  budget     Float?
  timeline   String?
  message    String?
  createdAt  DateTime @default(now())

  @@index([listingId])
}

model SellerInquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  product     String
  mrr         String?
  url         String?
  niche       String?
  askingPrice String?
  notes       String?
  createdAt   DateTime @default(now())
}
