// Cladak — Phase 1+ schema (SQLite) auth + audit + automation rails

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  role         String    @default("BUYER") // BUYER | SELLER | ADMIN | COFOUNDER
  passwordHash String?
  createdAt    DateTime  @default(now())
  listings     Listing[]
}

model Listing {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String
  category    String  @default("Micro-SaaS")
  websiteUrl  String?
  // PUBLIC = show URL · INTRO_ONLY = hide until platform intro
  demoPolicy  String  @default("INTRO_ONLY")
  tagline     String?
  niche       String?
  techStack   String?
  foundedYear Int?
  featured    Boolean @default(false)

  // Money stored as Float for display; fee ledger uses integer pence for settlement precision
  mrr         Float?
  askingPrice Float
  multiple    Float?

  mrrHistory      String?
  highlights      String?
  reasonForSale   String?
  customersApprox Int?
  businessModel   String?
  gallery         String?

  // Diligence evidence (seller-attested links — not live Stripe/GA scrape)
  evidenceRevenue    Boolean @default(false)
  evidenceProduct    Boolean @default(false)
  evidenceUi         Boolean @default(false)
  evidenceRevenueUrl String?
  evidenceProductUrl String?
  evidenceNotes      String?
  swornEvidence      Boolean @default(false)

  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id])

  // PENDING | VERIFIED | REJECTED | CLOSING | SOLD_PURGED
  verificationStatus String  @default("PENDING")
  verificationNotes  String?
  verifiedAt         DateTime?

  score Float?
  grade String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads       Lead[]
  escrowCases EscrowCase[]

  @@index([verificationStatus, category])
  @@index([featured])
  @@index([sellerId])
}

model ScoringRubric {
  id         String   @id @default(cuid())
  category   String   @unique
  version    Int      @default(1)
  criteria   String
  gradeBands String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Lead {
  id         String  @id @default(cuid())
  listingId  String
  listing    Listing @relation(fields: [listingId], references: [id])

  buyerName  String
  buyerEmail String
  budget     Float?
  timeline   String?
  message    String?

  // QUEUED | INTRODUCED | CLOSED_REPORTED
  status        String  @default("QUEUED")
  introducedAt  DateTime?
  closedNote    String?

  acceptedTerms            Boolean @default(false)
  acceptedNonCircumvention Boolean @default(false)
  ipHash                   String?
  userAgent                String?

  createdAt DateTime @default(now())

  escrowCases EscrowCase[]

  @@index([listingId])
  @@index([buyerEmail])
  @@index([status])
}

model SellerInquiry {
  id                       String   @id @default(cuid())
  name                     String
  email                    String
  product                  String
  mrr                      String?
  url                      String?
  niche                    String?
  askingPrice              String?
  notes                    String?
  acceptedSellerTerms      Boolean  @default(false)
  acceptedNonCircumvention Boolean  @default(false)
  // NEW | REVIEWING | ACCEPTED | DECLINED
  status                   String   @default("NEW")
  ipHash                   String?
  createdAt                DateTime @default(now())

  @@index([email])
  @@index([status])
}

model DataRightsRequest {
  id          String   @id @default(cuid())
  email       String
  fullName    String
  requestType String // ACCESS | DELETE | CORRECT
  details     String?
  ipHash      String?
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  action     String
  entityType String?
  entityId   String?
  meta       String?
  ipHash     String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([entityType, entityId])
}

model PlatformConfig {
  id                         String  @id @default("default")
  successFeeMinPercent       Float   @default(3)
  successFeeMaxPercent       Float   @default(5)
  supportEmail               String  @default("support@cladak.com")
  governingLaw               String  @default("England and Wales")
  nonCircumventionDays       Int     @default(730)
  autoIntroduceLeads         Boolean @default(true)
  // Blind auto-verify OFF — verify only when evidence pack is complete
  autoVerifyOnSubmit         Boolean @default(false)
  verifyWhenEvidenceComplete Boolean @default(true)
  purgeAccountsOnClose       Boolean @default(true)
  escrowPartnerName          String  @default("Licensed escrow partner")
  escrowPartnerUrl           String  @default("https://www.escrow.com")
}

// Anonymous fee receipts only — no buyer/seller PII after purge
model FeeLedger {
  id              String   @id @default(cuid())
  amountGbp       Float
  amountPence     Int      @default(0) // integer GBP pence — settlement source of truth
  feePercent      Float
  listingSlugHash String
  leadIdHash      String
  paymentRef      String?  @unique // prevents double-settle on same payment
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([leadIdHash])
}

// Durable rate-limit buckets (Redis optional via Upstash; this works without Redis)
model RateLimitBucket {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

// Cladak never holds funds — partner escrow case tracking only
model EscrowCase {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id])
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id])
  amountGbp   Float
  partnerName String
  partnerUrl  String?
  // REQUESTED | REFERRED | FUNDED | RELEASED | CANCELLED
  status      String   @default("REQUESTED")
  buyerEmail  String
  sellerEmail String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
  @@index([listingId])
  @@index([leadId])
}

// Automated notifications — sent via Resend when configured, else queued
model EmailOutbox {
  id        String   @id @default(cuid())
  toEmail   String
  subject   String
  bodyText  String
  template  String
  // QUEUED | SENT | FAILED
  status    String   @default("QUEUED")
  error     String?
  meta      String?
  createdAt DateTime @default(now())
  sentAt    DateTime?

  @@index([status, createdAt])
  @@index([template])
}
